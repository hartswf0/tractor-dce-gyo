 "voice": [
  {
   "shot": 6,
   "speaker": "Athena",
   "words": "It is Odysseus my heart breaks for",
   "at": 22.0,
   "dur": 3.78,
   "clip_lufs": -20.1,
   "gain_db": 4.1
  },
  {
   "shot": 7,
   "speaker": "Athena",
   "words": "wise, unlucky Odysseus, held against his will on Calypso's island",
   "at": 26.3,
   "dur": 6.11,
   "clip_lufs": -17.7,
   "gain_db": 1.7
  },
  {
   "shot": 8,
   "speaker": "Athena",
   "words": "longing only for the sight of smoke rising from his own hearth",
   "at": 33.0,
   "dur": 4.93,
   "clip_lufs": -17.8,
   "gain_db": 1.8
  },
  {
   "shot": 9,
   "speaker": "Odysseus",
   "words": "every day I long for home and the hour of my return",
   "at": 38.9,
   "dur": 4.61,
   "clip_lufs": -16.2,
   "gain_db": 0.2
  },
  {
   "shot": 10,
   "speaker": "Polyphemus",
   "words": "grant that Odysseus, sacker of cities, never reach his home.",
   "at": 44.85,
   "dur": 4.78,
   "clip_lufs": -17.4,
   "gain_db": 1.4
  },
  {
   "shot": 11,
   "speaker": "Polyphemus",
   "words": "Or if he must, let him come late and broken,",
   "at": 50.3,
   "dur": 3.84,
   "clip_lufs": -23.0,
   "gain_db": 7.0
  },
  {
   "shot": 12,
   "speaker": "Polyphemus",
   "words": "on a stranger's ship, all his comrades lost",
   "at": 54.8,
   "dur": 3.83,
   "clip_lufs": -16.4,
   "gain_db": 0.4
  },
  {
   "shot": 13,
   "speaker": "Tiresias",
   "words": "You seek a honey-sweet homecoming, but a god will make it bitter.",
   "at": 59.3,
   "dur": 7.08,
   "clip_lufs": -24.0,
   "gain_db": 8.0
  },
  {
   "shot": 14,
   "speaker": "Odysseus",
   "words": "Row, friends \u2014 we have been in worse and lived, and this too we shall remember.",
   "at": 66.8,
   "dur": 6.92,
   "clip_lufs": -19.4,
   "gain_db": 3.4
  },
  {
   "shot": 17,
   "speaker": "Epic Narrator",
   "words": "After twenty years",
   "at": 84.1,
   "dur": 2.75,
   "clip_lufs": -26.5,
   "gain_db": 10.5
  },
  {
   "shot": 18,
   "speaker": "Antinous",
   "words": "she unraveled it thread by thread.",
   "at": 88.2,
   "dur": 5.74,
   "clip_lufs": -24.8,
   "gain_db": 8.8
  },
  {
   "shot": 19,
   "speaker": "Eurycleia",
   "words": "The man you have mourned twenty years is sitting by his own fire.",
