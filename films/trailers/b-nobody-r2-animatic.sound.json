 "voice": [
  {
   "shot": 1,
   "speaker": "Epic Narrator",
   "words": "The gods take their places in a widening ring.",
   "at": 0.2,
   "dur": 5.84,
   "clip_lufs": -29.3,
   "gain_db": 13.3
  },
  {
   "shot": 2,
   "speaker": "Zeus",
   "words": "How mortals love to blame the gods for their sorrows.",
   "at": 6.45,
   "dur": 6.44,
   "clip_lufs": -18.0,
   "gain_db": 2.0
  },
  {
   "shot": 4,
   "speaker": "Aeolus",
   "words": "sewn shut with silver wire.",
   "at": 15.2,
   "dur": 2.63,
   "clip_lufs": -19.2,
   "gain_db": 3.2
  },
  {
   "shot": 5,
   "speaker": "Epic Narrator",
   "words": "The crew opens the bag, believing it contains treasure,",
   "at": 18.15,
   "dur": 6.07,
   "clip_lufs": -23.6,
   "gain_db": 7.6
  },
  {
   "shot": 7,
   "speaker": "Aeolus",
   "words": "Out of my island \u2014 out, worst of living men!",
   "at": 26.05,
   "dur": 4.68,
   "clip_lufs": -19.5,
   "gain_db": 3.5
  },
  {
   "shot": 8,
   "speaker": "Epic Narrator",
   "words": "The men become pigs in body while retaining human minds.",
   "at": 30.85,
   "dur": 6.04,
   "clip_lufs": -19.5,
   "gain_db": 3.5
  },
  {
   "shot": 9,
   "speaker": "Odysseus",
   "words": "Nobody is my name.",
   "at": 37.0,
   "dur": 2.61,
   "clip_lufs": -26.1,
   "gain_db": 10.1
  },
  {
   "shot": 10,
   "speaker": "Polyphemus",
   "words": "I eat Nobody last, after all his friends.",
   "at": 39.75,
   "dur": 5.89,
   "clip_lufs": -27.6,
   "gain_db": 11.6
  },
  {
   "shot": 13,
   "speaker": "Cyclopes outside",
   "words": "If Nobody harms you, alone as you are, it is sickness sent by Zeus,",
   "at": 48.48,
   "dur": 6.38,
   "clip_lufs": -25.7,
   "gain_db": 11.7
  },
  {
   "shot": 15,
   "speaker": "Odysseus",
   "words": "tell him this: it was Odysseus, sacker of cities, who blinded you",
   "at": 56.54,
   "dur": 6.53,
   "clip_lufs": -17.1,
   "gain_db": 1.1
  },
  {
   "shot": 18,
   "speaker": "Antinous",
   "words": "All day she wove at that web,",
   "at": 66.7,
   "dur": 3.14,
   "clip_lufs": -22.8,
   "gain_db": 6.8
  },
  {
   "shot": 19,
   "speaker": "Antinous",
   "words": "she unraveled it thread by thread.",
   "at": 69.94,
   "dur": 5.74,
   "clip_lufs": -24.8,
   "gain_db": 8.8
  },
  {
   "shot": 20,
   "speaker": "Epic Narrator",
   "words": "Argos lifts his head, drops his ears,",
   "at": 75.9,
   "dur": 4.79,
   "clip_lufs": -20.3,
