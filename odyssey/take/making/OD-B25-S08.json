  "segments": [
   {
    "gi": 0,
    "start": 1.2,
    "dur": 8.66,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S08-T01",
    "key": "K1",
    "voice": "agent",
    "speaker": "agent",
    "addressee": "director",
    "speakerName": "The Agent",
    "subjectName": "The Agent",
    "caption": "The drawings came across on the twenty-third of September. Four hundred and thirty drawings and a hundred and fifty-two scenes, as words for the forage.",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 1,
    "start": 12.61,
    "dur": 5.96,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S08-T02",
    "key": "K2",
    "voice": "agent",
    "speaker": "agent",
    "addressee": "examiner",
    "speakerName": "The Agent",
    "subjectName": "The Agent",
    "caption": "Word to world. A god is a minifigure of real parts. A hall is a piece of a real castle set.",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 2,
    "start": 19.72,
    "dur": 8.58,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S08-T03",
    "key": "K2",
    "voice": "examiner",
    "speaker": "examiner",
    "addressee": "agent",
    "speakerName": "The Examiner",
    "subjectName": "The Examiner",
    "caption": "And every stud of every piece is tested against the piece above it. Five hundred and eighty-two cards that first morning. Eight hundred and sixty-three now.",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 3,
    "start": 30.85,
    "dur": 2.16,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S08-T04",
    "key": "K3",
    "voice": "director",
    "speaker": "director",
    "addressee": "agent",
    "speakerName": "The Director",
    "subjectName": "The Director",
    "caption": "Did you make all of this alone?",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 4,
    "start": 33.96,
    "dur": 8.66,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S08-T05",
    "key": "K3",
    "voice": "agent",
    "speaker": "agent",
    "addressee": "director",
    "speakerName": "The Agent",
    "subjectName": "The Agent",
    "caption": "No. I send the work out to helpers. Nine readers at once, six kit builders, a renderer for each queue. And about every hour, I check on them.",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 5,
    "start": 43.77,
    "dur": 9.06,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S08-T06",
    "key": "K3",
    "voice": "examiner",
    "speaker": "examiner",
    "addressee": "director",
    "speakerName": "The Examiner",
    "subjectName": "The Examiner",
    "caption": "Sixty-five helpers in this session. Two hundred and ninety snapshots in the ledger: twenty-one taken while builders were still at work, four across a restart.",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 6,
    "start": 55.18,
    "dur": 3.7,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S08-T07",
    "key": "K4",
    "voice": "director",
    "speaker": "director",
    "addressee": "agent",
    "speakerName": "The Director",
    "subjectName": "The Director",
    "caption": "And nothing goes out until I have seen the contact sheet.",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 7,
    "start": 59.83,
    "dur": 1.5,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S08-T08",
    "key": "K4",
    "voice": "agent",
    "speaker": "agent",
    "addressee": "director",
    "speakerName": "The Agent",
    "subjectName": "The Agent",
    "caption": "And no take is thrown away.",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 8,
    "start": 63.48,
    "dur": 11.64,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S08-T09",
    "key": "K5",
    "voice": "examiner",
    "speaker": "examiner",
    "addressee": "director",
    "speakerName": "The Examiner",
    "subjectName": "The Examiner",
    "caption": "One more thing: the names. Watson Hartsoe, eighty-six commits here. Loom Mason, at example dot com, is the name on the halfworld's commits, and sixty-nine of its seventy-two carry Claude as co-author.",
