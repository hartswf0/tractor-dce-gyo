    "voice": "agent",
    "speaker": "agent",
    "addressee": "director",
    "speakerName": "The Agent",
    "subjectName": "The Agent",
    "caption": "So it is split. Each location's geometry goes beside the player, in a file of its own, fetched when the scene loads.",
