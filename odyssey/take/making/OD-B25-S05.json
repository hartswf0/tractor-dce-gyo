  "segments": [
   {
    "gi": 0,
    "start": 1.2,
    "dur": 4.84,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S05-T01",
    "key": "K1",
    "voice": "examiner",
    "speaker": "examiner",
    "addressee": "director",
    "speakerName": "The Examiner",
    "subjectName": "The Examiner",
    "caption": "Before the bricks there was another film, drawn in dots on paper. It was called the halfworld.",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 1,
    "start": 6.99,
    "dur": 1.3,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S05-T02",
    "key": "K1",
    "voice": "director",
    "speaker": "director",
    "addressee": "examiner",
    "speakerName": "The Director",
    "subjectName": "The Director",
    "caption": "Where does it start?",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 2,
    "start": 9.24,
    "dur": 7.16,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S05-T03",
    "key": "K1",
    "voice": "examiner",
    "speaker": "examiner",
    "addressee": "director",
    "speakerName": "The Examiner",
    "subjectName": "The Examiner",
    "caption": "Its first commit: the twenty-third of July, at six minutes to three in the morning. Four hundred and ninety-four files at once.",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 3,
    "start": 18.95,
    "dur": 4.98,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S05-T04",
    "key": "K2",
    "voice": "agent",
    "speaker": "agent",
    "addressee": "director",
    "speakerName": "The Agent",
    "subjectName": "The Agent",
    "caption": "And with them, a card. Paste this into Claude, with any book. The film is the program.",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 4,
    "start": 24.88,
    "dur": 1.78,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S05-T05",
    "key": "K2",
    "voice": "director",
    "speaker": "director",
    "addressee": "agent",
    "speakerName": "The Director",
    "subjectName": "The Director",
    "caption": "What does the card ask for?",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 5,
    "start": 29.01,
    "dur": 8.34,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S05-T06",
    "key": "K3",
    "voice": "agent",
    "speaker": "agent",
    "addressee": "director",
    "speakerName": "The Agent",
    "subjectName": "The Agent",
    "caption": "First the atlas: every book broken into scenes, every scene into beats, each beat causing the next. Then one engine. Then the drawings.",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 6,
    "start": 38.5,
    "dur": 11.5,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S05-T07",
    "key": "K3",
    "voice": "agent",
    "speaker": "agent",
    "addressee": "director",
    "speakerName": "The Agent",
    "subjectName": "The Agent",
    "caption": "Every figure is a small program that draws itself in flat tone. One last pass prints the frame as dots on a grid, as Knowlton's films were made at Bell Labs in 1963.",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 7,
    "start": 52.55,
    "dur": 8.5,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S05-T08",
    "key": "K4",
    "voice": "examiner",
    "speaker": "examiner",
    "addressee": "director",
    "speakerName": "The Examiner",
    "subjectName": "The Examiner",
    "caption": "Fifteen books were already in that first commit: three hundred and seven drawings, ninety-four scenes. How they were made before it, the record does not say.",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 8,
    "start": 62.8,
    "dur": 3.28,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S05-T09",
    "key": "K4",
    "voice": "agent",
    "speaker": "agent",
    "addressee": "director",
    "speakerName": "The Agent",
    "subjectName": "The Agent",
    "caption": "The card says how. Build a few, verify, then fan out.",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 9,
    "start": 67.03,
    "dur": 1.44,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S05-T10",
    "key": "K4",
    "voice": "director",
    "speaker": "director",
    "addressee": "agent",
    "speakerName": "The Director",
    "subjectName": "The Director",
    "caption": "Fan out to whom?",
    "isLine": true,
    "act": null,
    "delivery": null
   },
   {
    "gi": 10,
    "start": 72.02,
    "dur": 1.44,
    "kind": "DIALOGUE",
    "turn": "OD-B25-S05-T11",
    "key": "K5",
    "voice": "agent",
    "speaker": "agent",
    "addressee": "director",
    "speakerName": "The Agent",
    "subjectName": "The Agent",
    "caption": "To many of me, at once.",
    "isLine": true,
    "act": null,
    "delivery": null
   }
  ]
