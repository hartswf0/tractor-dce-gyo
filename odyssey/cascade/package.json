{
  "name": "odyssey-cascade",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "check:graphs": "for g in kit attention clocks forbidden facing beflix; do cascade check $g.cascade || exit 1; done",
    "extract": "node tools/extract.cjs && python3 tools/clashes.py",
    "build": "node tools/build.mjs",
    "media": "node tools/media.mjs && node tools/beflix_film.mjs",
    "verify": "node tools/verify.mjs",
    "kit": "cascade run kit.cascade --frames 240 --fps 24 && python3 tools/gesture_kit.py"
  },
  "devDependencies": {
    "cascade": "npm:@field/cascade@0.7.1",
    "typescript": "^6.0.0"
  }
}
