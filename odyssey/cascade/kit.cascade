{
  "version": "0.2",
  "metadata": {
    "name": "A kit of a motion",
    "description": "Telemachus's welcome (or Odysseus's bow draw) read from the choreography sheet, the hand swept through time by the minifigure's kinematics, the trail quantized to studs and plates: print, motion, web, and (offline) a kit."
  },
  "nodes": [
    {
      "id": "hand",
      "module": "project.ChoreoHand",
      "position": [
        0,
        0
      ],
      "source": "project",
      "props": {
        "sheet": {
          "path": "assets/gestures.json",
          "mediaType": "application/json"
        },
        "gesture": "welcome",
        "side": "R",
        "frame": "world",
        "samples": 360,
        "now": {
          "value": 1,
          "expression": "clamp(($F - 1) / 239, 0, 1)"
        },
        "upto": true
      }
    },
    {
      "id": "grid",
      "module": "project.StudGrid",
      "position": [
        260,
        0
      ],
      "source": "project",
      "props": {
        "scale": 1,
        "minRun": 1,
        "filename": "gesture-cells-now.json"
      }
    },
    {
      "id": "bricks",
      "module": "project.Bricks",
      "position": [
        520,
        0
      ],
      "source": "project",
      "props": {
        "azimuth": 35,
        "elevation": 30,
        "supports": true
      }
    },
    {
      "id": "vtrail",
