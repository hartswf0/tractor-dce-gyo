oud, she told us, for the lord Laertes, so no woman of the land could reproach her if he lay in death without a winding-sheet. All day she wove at that web, and every night, with torches set beside her, she unraveled it thread by thread.","who":"antinous","kind":"DIALOGUE"},{"at":50.38,"dur":9,"caption":"Send her back to her father Icarius, and let her marry the man he names, and the man she chooses.","who":"antinous","kind":"DIALOGUE"}],"words":[{"t":0.75,"w":"Bold"},{"t":1.21,"w":"tongued"},{"t":1.945,"w":"Telemachus"},{"t":3.048,"w":"do"},{"t":3.323,"w":"not"},{"t":3.691,"w":"lay"},{"t":4.059,"w":"your"},{"t":4.518,"w":"blame"},{"t":5.07,"w":"at"},{"t":5.345,"w":"our"},{"t":5.713,"w":"door"},{"t":6.265,"w":"It"},{"t":6.54,"w":"is"},{"t":6.816,"w":"not"},{"t":7.184,"w":"the"},{"t":7.551,"w":"suitors"},{"t":8.287,"w":"who"},{"t":8.654,"w":"are"},{"t":9.022,"w":"at"},{"t":9.298,"w":"fault"},{"t":9.849,"w":"but"},{"t":10.217,"w":"your"},{"t":10.676,"w":"own"},{"t":11.044,"w":"mother"},{"t":11.779,"w":"that"},{"t":12.239,"w":"queen"},{"t":12.79,"w":"of"},{"t":13.066,"w":"cunning"},{"t":13.893,"w":"three"},{"t":14.444,"w":"years"},{"t":14.996,"w":"now"},{"t":15.455,"w":"and"},{"t":15.823,"w":"nearly"},{"t":16.466,"w":"four"},{"t":17.018,"w":"she"},{"t":17.386,"w":"has"},{"t":17.753,"w":"cheated"},{"t":18.488,"w":"the"},{"t":18.856,"w":"hearts"},{"t":19.499,"w":"of"},{"t":19.775,"w":"the"},{"t":20.143,"w":"Achaeans"},{"t":21.72,"w":"She"},{"t":22.119,"w":"set"},{"t":22.519,"w":"up"},{"t":22.818,"w":"her"},{"t":23.218,"w":"great"},{"t":23.817,"w":"loom"},{"t":24.316,"w":"in"},{"t":24.616,"w":"the"},{"t":25.015,"w":"hall"},{"t":25.614,"w":"a"},{"t":25.814,"w":"shroud"},{"t":26.613,"w":"she"},{"t":27.012,"w":"told"},{"t":27.512,"w":"us"},{"t":27.911,"w":"for"},{"t":28.311,"w":"the"},{"t":28.71,"w":"lord"},{"t":29.209,"w":"Laertes"},{"t":30.108,"w":"so"},{"t":30.408,"w":"no"},{"t":30.707,"w":"woman"},{"t":31.306,"w":"of"},{"t":31.606,"w":"the"},{"t":32.005,"w":"land"},{"t":