 "annotations": [
  {
   "id": "note",
   "position": [
    0,
    -160
   ],
   "size": [
    900,
    120
   ],
   "text": "OD-B12-S06 on the rig desk. Each actor is a Subnet with one Minifig Rig: its generated choreography comes from assets/rig/OD-B12-S06/<actor>.json; the director's layer is the rig's own props (an offset per servo, a weight per body part), keyed in the Timeline against the Voice Track. Preview headless: cascade run rig-OD-B12-S06.cascade --frames 1-458 --fps 12. Export: node tools/rig_export.mjs OD-B12-S06."
  }
 ]
