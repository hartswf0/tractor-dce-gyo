{
 "version": "0.2",
 "metadata": {
  "name": "BEFLIX in Cascade",
  "description": "Ken Knowlton's BEFLIX (Bell Labs, 1963) as a node graph: a 252 x 184 mosaic of ink levels 0-7, mutated by his operations (PAINT, LINE, TEXT, SHIFT, ZOOM, EXPAND/SHRINK, COPY, DISSOLVE) and photographed. Its footage is Halfworld's The Sirens' Song (OD-B12-S03), baked from Halfworld's own asset programs and staging; its clock is Halfworld's recording of the scene, whose amplitude drives the dissolves, the zoom, the Poem Field and the ink. Every frame is also a LEGO mosaic.",
  "fps": 24,
  "frames": [
   1,
   1241
  ]
 },
