  {
   "id": "poem",
   "module": "project.BxPoemField",
   "position": [
    1540,
    0
   ],
   "source": "project",
   "props": {
    "text": "Come here, far-famed Odysseus, great glory of the Achaeans - stay your ship and hear our voices. No man has ever rowed past us till he heard the honeyed song from our lips, and went away delighted, knowing more than he knew.",
