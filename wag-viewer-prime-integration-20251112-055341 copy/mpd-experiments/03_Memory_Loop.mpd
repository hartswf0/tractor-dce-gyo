0 FILE Memory_Loop.mpd
0 Name: The Memory Loop (Relation-Image)
0 Author: Mento Typology
0 !LDRAW_ORG Model

0 // ============================================================
0 // MENTO LIGHTING: GOLDEN HOUR NOSTALGIA
0 // ============================================================
0 // SUN: Low horizon, warm orange/gold
0 !MENTO LIGHT "Golden Sun" TYPE SUN POS -500 -100 500 TGT 0 -50 0 COLOR #FFCC88 INTENSITY 2.0 SHADOWS TRUE

0 // BOUNCE: Soft warm fill from "ground"
0 !MENTO LIGHT "Warm Bounce" TYPE POINT POS 50 -10 50 COLOR #FFDDAA INTENSITY 0.8

0 // ============================================================
0 // MENTO CAMERA: BRACKET SYNTAGMA (RELATIONAL)
0 // ============================================================
0 // SHOT 1: The Object (A Token of Memory) - Macro
0 !MENTO SHOT "Token Macro" POS 20 -30 20 TGT 0 -10 0 LENS 100

0 // SHOT 2: The Face (The reaction to the memory) - Shallow Depth
0 !MENTO SHOT "Face React" POS -100 -60 50 TGT -150 -60 0 LENS 85

0 // ============================================================
0 // SCENE GEOMETRY
0 // ============================================================
0 // THE TOKEN (Center) - A round brick, the memory object
1 14 0 -10 0 1 0 0 0 1 0 0 0 1 3062b.dat

0 // THE TABLE - Brown surface
1 6 0 0 0 5 0 0 0 1 0 0 0 5 3032.dat

0 // THE SUBJECT (Displaced, signifying separation from memory)
1 16 -150 0 0 1 0 0 0 1 0 0 0 1 970c00.dat
1 16 -150 -32 0 1 0 0 0 1 0 0 0 1 973.dat
1 16 -150 -56 0 0 0 1 0 1 0 -1 0 0 3626bp01.dat

0 STEP
0 NOFILE
